# Use an absolute path to a folder of synthetic test GIFs, outside the repository.
OVERLOAD_GIF_DIR=
OVERLOAD_GIF_NGINX_PORT=8081
OVERLOAD_GIF_BACKEND_UPSTREAM=host.docker.internal:8080
# Generate 32 random bytes and encode as 64 lowercase hex characters.
OVERLOAD_GIF_PROXY_TOKEN=
# Pass this variable separately to Spring Boot. Leave false without confirmed rights.
OVERLOAD_GIF_SERVING_ENABLED=false
