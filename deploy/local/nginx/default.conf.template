map $request_uri $gif_source_id {
    default "";
    "~^/media/exercises/v1/(?<canonical_gif_id>[A-Za-z0-9]{7})\.gif$" $canonical_gif_id;
}

map $request_uri $invalid_media_uri {
    default 0;
    "~^/media/exercises/v1/[A-Za-z0-9]{7}\.gif$" 0;
    ~^/media(?:/|\?|$) 1;
}

map $invalid_media_uri $invalid_media_cache_control {
    default "";
    1 "no-store";
}

# Resolve the protected mount only for the explicit decision from Spring.
map $gif_auth_status:$gif_auth_decision $gif_storage_root {
    default /var/empty/overload-gif-denied;
    "204:allow-v1" /var/lib/overload-gifs;
}

server {
    listen 8080;
    server_tokens off;
    autoindex off;
    add_header Cache-Control $invalid_media_cache_control always;

    # Reject noncanonical raw media URLs before normalized routing can reach another location.
    if ($invalid_media_uri) { return 404; }

    location ~ "^/media/exercises/v1/(?<gif_file_id>[A-Za-z0-9]{7})\.gif$" {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        if ($gif_source_id = "") { return 404; }
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        auth_request /__gif_authorize;
        auth_request_set $gif_auth_status $upstream_status;
        auth_request_set $gif_auth_decision $upstream_http_x_overload_gif_decision;
        alias $gif_storage_root/$gif_file_id.gif;
        disable_symlinks on from=/var/lib/overload-gifs;
        etag off;
        if_modified_since off;
        max_ranges 0;
    }

    location /media/ {
        add_header Cache-Control "no-store" always;
        return 404;
    }

    location = /__gif_authorize {
        internal;
        proxy_pass http://${OVERLOAD_GIF_BACKEND_UPSTREAM}/internal/media/exercise-gif/authorize;
        proxy_method GET;
        proxy_pass_request_headers off;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Overload-Gif-Proxy-Token "${OVERLOAD_GIF_PROXY_TOKEN}";
        proxy_set_header X-Overload-Gif-Source-Id $gif_source_id;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        proxy_ignore_headers X-Accel-Redirect;
        proxy_intercept_errors on;
        # auth_request accepts 401/403 for denials. Keep internal 404s indistinguishable.
        error_page 404 =403 /__gif_denied;
    }

    location = /__gif_denied {
        internal;
        return 403;
    }

    location ^~ /internal/ { return 404; }

    location ^~ /api/ {
        proxy_pass http://${OVERLOAD_GIF_BACKEND_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Overload-Gif-Proxy-Token "";
        proxy_set_header X-Overload-Gif-Source-Id "";
        proxy_ignore_headers X-Accel-Redirect;
    }

    location / { return 404; }
}
